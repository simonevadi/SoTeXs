{
    "peacock.color": "red",
    "python.terminal.activateEnvironment": true,
    "python.defaultInterpreterPath": "conda-env:rp",
    "terminal.integrated.defaultProfile.linux": "Conda rp",
    "terminal.integrated.profiles.linux": {
        "Conda rp": {
            "path": "bash",
            "args": [
                "-l",
                "-c",
                "if [ -x \"$HOME/miniconda3/bin/conda\" ]; then eval \"$($HOME/miniconda3/bin/conda shell.bash hook)\"; elif [ -x \"$HOME/anaconda3/bin/conda\" ]; then eval \"$($HOME/anaconda3/bin/conda shell.bash hook)\"; elif [ -x \"$HOME/mambaforge/bin/conda\" ]; then eval \"$($HOME/mambaforge/bin/conda shell.bash hook)\"; elif command -v conda >/dev/null 2>&1; then eval \"$(conda shell.bash hook)\"; fi; conda activate rp; exec bash -i"
            ]
        }
    },
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#ff3333",
        "activityBar.background": "#ff3333",
        "activityBar.foreground": "#e7e7e7",
        "activityBar.inactiveForeground": "#e7e7e799",
        "activityBarBadge.background": "#00df00",
        "activityBarBadge.foreground": "#15202b",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#ff3333",
        "statusBar.background": "#ff0000",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#ff3333",
        "statusBarItem.remoteBackground": "#ff0000",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#ff0000",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#ff000099",
        "titleBar.inactiveForeground": "#e7e7e799"
    }
}
